N1N_ILLUSTRATION_API_KEY=
# Owner-approved alternative: https://llm-api.net (base only, no /v1 path).
N1N_ILLUSTRATION_BASE_URL=https://api.n1n.ai
N1N_ILLUSTRATION_MODEL=qwen-image-3.0
N1N_ILLUSTRATION_ENABLED=false
N1N_ILLUSTRATION_DEFAULT_SIZE=1024x1024
N1N_ILLUSTRATION_WATERMARK=true
N1N_ILLUSTRATION_PROMPT_EXTEND=true
N1N_ILLUSTRATION_PROMPT_EXTEND_MODE=direct
N1N_ILLUSTRATION_SORT=success_rate
# Optional exact CDN hosts only after the gateway's image-URL contract is verified.
# Verified for this Preview on 2026-10-19: dashscope-463f.oss-accelerate.aliyuncs.com
# Other buckets require separate response/DNS/TLS verification; never use a wildcard.
N1N_ILLUSTRATION_ASSET_HOSTS=
