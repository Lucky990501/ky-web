# Copy to .env.production on the server and set each blank secret there.
APP_ENV=production
ENTERPRISE_POC_DATABASE_URL=postgresql://enterprise_agent:CHANGE_DB_PASSWORD@postgres:5432/enterprise_agent
POSTGRES_DB=enterprise_agent
POSTGRES_USER=enterprise_agent
POSTGRES_PASSWORD=CHANGE_DB_PASSWORD
REDIS_PASSWORD=CHANGE_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_REDIS_PASSWORD@redis:6379/0
ENTERPRISE_POC_TASK_QUEUE=redis
ENTERPRISE_POC_BOOTSTRAP_DEMO_DATA=false
ENTERPRISE_POC_SECURE_COOKIES=true
ENTERPRISE_POC_TOKEN_SECRET=CHANGE_LONG_RANDOM_SECRET
ENTERPRISE_POC_MCP_URL=http://platform-mcp:8091/mcp
ENTERPRISE_POC_MCP_PORT=8091
ENTERPRISE_POC_MODEL_PROVIDER_ID=deepseek
ENTERPRISE_POC_MODEL_ID=deepseek-v4-pro
ENTERPRISE_POC_REASONING_EFFORT=high
ENTERPRISE_POC_MODEL_BASE_URL=https://api.deepseek.com/
ENTERPRISE_POC_MODEL_WIRE_API=responses
ENTERPRISE_POC_CODEX_API_KEY_ENV=DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=
ENTERPRISE_POC_IMAGE_PROVIDER_ID=image-gateway
ENTERPRISE_POC_IMAGE_MODEL_ID=gateway-managed-gpt-image-2
ENTERPRISE_POC_IMAGE_API_KEY_ENV=GATEWAY_API_TOKEN
GATEWAY_API_TOKEN=
ENTERPRISE_POC_OBJECT_STORAGE_PROVIDER=oss
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET_NAME=
OSS_WORKBENCH_PREFIX=enterprise-agent-workbench
OSS_SIGNED_URL_EXPIRE_SECONDS=900
# RAG production guards. Keep query guarding enabled unless a reviewed release
# has a replacement policy. Tune thresholds only with a saved evaluation.
KNOWLEDGE_MIN_FINAL_SCORE=0.20
KNOWLEDGE_MIN_VECTOR_SCORE=0.30
KNOWLEDGE_KEYWORD_EXACT_MATCH=false
KNOWLEDGE_RESULT_MARGIN=0.02
KNOWLEDGE_QUERY_GUARD_ENABLED=true

# Inactive Qwen migration-evaluation profile. Do not copy these values into
# active EMBEDDING_* variables before the controlled migration gate passes.
# The endpoint and API key must belong to the same China (Beijing) workspace.
ALIYUN_BAILIAN_EMBEDDING_PROVIDER=aliyun-bailian
ALIYUN_BAILIAN_EMBEDDING_MODEL=qwen3.7-text-embedding
ALIYUN_BAILIAN_EMBEDDING_DIMENSION=1536
ALIYUN_BAILIAN_INDEX_VERSION=rag-index-v3-qwen
ALIYUN_BAILIAN_EMBEDDING_BASE_URL=
ALIYUN_BAILIAN_API_KEY=

# Inactive APIYI provider-evaluation profile. Never copy the key or URL into
# active EMBEDDING_* variables before the manual provider-switch decision.
APIYI_EMBEDDING_PROVIDER_ID=apiyi-candidate
APIYI_EMBEDDING_MODEL=text-embedding-3-small
APIYI_EMBEDDING_DIMENSION=1536
APIYI_EMBEDDING_BASE_URL=https://api.apiyi.com/v1
APIYI_EMBEDDING_API_KEY=
