# Copy this file to .deploy-secrets.local. Never commit the local file.
PROJECT_NAME=my-website
SERVER_HOST=203.0.113.10
SERVER_USER=deploy
SERVER_PORT=22
SERVER_STAGE_DIR=/home/deploy/my-website-bridge
SERVER_RELEASE_ROOT=/var/www/my-website
SERVER_SSH_KEY_PATH=C:\Users\your-name\.ssh\my-website-server
GITHUB_REMOTE=github-my-website:owner/repository.git
GITHUB_BRANCH=main
HEALTHCHECK_HOST=www.example.com
HEALTHCHECK_URL=https://www.example.com/
# Use this when HTTPS is terminated by a CDN, load balancer, or reverse proxy.
ORIGIN_HEALTHCHECK_HOST=www.example.com
ORIGIN_HEALTHCHECK_URL=http://127.0.0.1/
